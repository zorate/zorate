# MongoDB — Primary Database
MONGODB_URI=mongodb://localhost:27017/zorate

# JWT Authentication
JWT_SECRET=replace-this-with-a-very-long-random-string-at-least-64-chars
JWT_EXPIRES_IN=7d

# Admin credentials (used for initial seed only)
ADMIN_EMAIL=zoratejoseph@gmail.com
ADMIN_PASSWORD=changeme-on-first-deploy

# Server
PORT=3000
NODE_ENV=development

# Site URL (no trailing slash)
SITE_URL=http://localhost:3000