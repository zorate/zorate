<%- include('../partials/head') %>
<%- include('../partials/nav') %>

<main class="container section">
  <div class="reveal">
    <h1 class="display-text" style="font-size: clamp(2.5rem, 6vw, 4rem); margin-bottom: 1rem;">The Lab</h1>
    <p style="font-size: 1.1rem; max-width: 600px; margin-bottom: 3rem;">Engineering notes, technical breakdowns, and lessons learned from building systems in constrained environments.</p>
  </div>

  <% if (allTags && allTags.length > 0) { %>
    <div class="flex gap-2 reveal reveal-delay-1" style="margin-bottom: 3rem; flex-wrap: wrap;">
      <a href="/lab" class="badge <%= !activeTag ? 'badge-accent' : '' %>">All</a>
      <% allTags.forEach(tag => { %>
        <a href="/lab?tag=<%= tag %>" class="badge <%= activeTag === tag ? 'badge-accent' : '' %>"><%= tag %></a>
      <% }) %>
    </div>
  <% } %>

  <div class="flex-col gap-8 reveal reveal-delay-2" style="max-width: 800px;">
    <% posts.forEach((post) => { %>
      <article class="border-b" style="padding-bottom: 2rem;">
        <div class="mono-text" style="font-size: 0.75rem; color: var(--text-tertiary); margin-bottom: 0.8rem;">
          <%= new Date(post.publishedAt).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) %> 
          <span style="margin: 0 0.5rem;">//</span> <%= post.readTime %> MIN READ
        </div>
        <h2 class="display-text" style="font-size: 2rem; margin-bottom: 0.8rem;">
          <a href="/lab/<%= post.slug %>" class="hover:text-accent" style="color: var(--text-primary);"><%= post.title %></a>
        </h2>
        <p style="font-size: 1.05rem; margin-bottom: 1.5rem; max-width: 700px;"><%= post.excerpt %></p>
        <a href="/lab/<%= post.slug %>" class="link-accent mono-text">READ ARTICLE →</a>
      </article>
    <% }) %>
    
    <% if (posts.length === 0) { %>
      <div style="padding: 4rem 0; text-align: center;">
        <p class="mono-text">No articles found in the lab.</p>
      </div>
    <% } %>
  </div>
</main>

<%- include('../partials/footer') %>