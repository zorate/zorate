<%- include('../partials/head') %>
<%- include('../partials/nav') %>

<main class="container section" style="max-width: 900px;">
  <article class="reveal">
    <a href="/lab" class="mono-text link-accent" style="display: inline-block; margin-bottom: 2rem;">← Back to Lab</a>
    
    <header style="margin-bottom: 3rem;">
      <div class="mono-text" style="font-size: 0.8rem; color: var(--text-tertiary); margin-bottom: 1rem;">
        <%= new Date(post.publishedAt).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) %> 
        <span style="margin: 0 0.5rem;">//</span> <%= post.readTime %> MIN READ
      </div>
      <h1 class="display-text" style="font-size: clamp(2.5rem, 5vw, 3.5rem); margin-bottom: 1.5rem; line-height: 1.1;"><%= post.title %></h1>
      
      <% if (post.tags && post.tags.length > 0) { %>
        <div class="flex gap-2">
          <% post.tags.forEach(tag => { %>
            <span class="badge"><%= tag %></span>
          <% }) %>
        </div>
      <% } %>
    </header>

    <% if (post.coverMediaId) { %>
      <img src="/api/media/<%= post.coverMediaId %>/file" alt="Cover" style="width: 100%; border-radius: var(--radius-md); margin-bottom: 3rem; border: 1px solid var(--border-subtle);">
    <% } %>

    <div class="grid" style="grid-template-columns: 1fr; gap: 4rem;">
      <div class="markdown-body" style="font-size: 1.1rem; line-height: 1.8; color: #d4d0ce;">
        <%- renderedContent %>
      </div>
    </div>
  </article>
</main>

<style>
.markdown-body h2 { font-family: var(--font-display); font-size: 2.2rem; margin: 2.5rem 0 1rem; color: var(--text-primary); }
.markdown-body h3 { font-family: var(--font-display); font-size: 1.6rem; margin: 2rem 0 1rem; color: var(--text-primary); }
.markdown-body p { margin-bottom: 1.5rem; }
.markdown-body ul, .markdown-body ol { margin-bottom: 1.5rem; padding-left: 1.5rem; }
.markdown-body li { margin-bottom: 0.5rem; }
.markdown-body img { max-width: 100%; border-radius: var(--radius-sm); border: 1px solid var(--border-subtle); margin: 2rem 0; display: block; }
.markdown-body strong { color: var(--text-primary); }
.markdown-body a { color: var(--accent); text-decoration: underline; text-decoration-color: rgba(91,127,255,0.3); text-underline-offset: 4px; }
.code-block { background: #0a0a0b; padding: 1.5rem; border-radius: var(--radius-sm); border: 1px solid var(--border-subtle); overflow-x: auto; margin: 2rem 0; font-family: var(--font-mono); font-size: 0.9rem; line-height: 1.5; color: #e8e6e3; }
.post-callout { border-left: 3px solid var(--accent); padding: 1rem 1.5rem; margin: 2rem 0; background: var(--bg-surface-1); color: var(--text-primary); border-radius: 0 var(--radius-sm) var(--radius-sm) 0; }
</style>

<%- include('../partials/footer') %>