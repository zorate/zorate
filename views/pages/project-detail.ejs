<%- include('../partials/head') %>
<%- include('../partials/nav') %>

<main class="container section">
  <div class="reveal">
    <a href="/projects" class="mono-text link-accent" style="display: inline-block; margin-bottom: 2rem;">← Back to Systems</a>
    
    <div class="flex items-center gap-4" style="margin-bottom: 1rem;">
      <h1 class="display-text" style="font-size: clamp(2.5rem, 6vw, 4rem); margin: 0;"><%= project.title %></h1>
      <% if (project.status === 'production') { %>
        <span class="badge badge-success" style="transform: translateY(4px);">Live</span>
      <% } else if (project.status === 'archived') { %>
        <span class="badge" style="transform: translateY(4px);">Archived</span>
      <% } else { %>
        <span class="badge" style="transform: translateY(4px);">Dev</span>
      <% } %>
    </div>
    
    <p style="font-size: 1.2rem; max-width: 700px; color: var(--text-primary); margin-bottom: 3rem;"><%= project.tagline %></p>
  </div>

  <div class="grid reveal reveal-delay-1" style="grid-template-columns: 1fr 300px; gap: 4rem;">
    <!-- Main Content -->
    <div class="case-study-content">
      <% if (project.coverMediaId) { %>
        <img src="/api/media/<%= project.coverMediaId %>/file" alt="<%= project.title %> cover" style="width: 100%; border-radius: var(--radius-md); border: 1px solid var(--border-subtle); margin-bottom: 3rem;">
      <% } %>

      <div class="markdown-body" style="font-size: 1.05rem; line-height: 1.8;">
        <%- renderedContent %>
      </div>
    </div>

    <!-- Sidebar Meta -->
    <aside>
      <div style="position: sticky; top: 2rem;">
        <div class="card" style="margin-bottom: 2rem; padding: 1.5rem;">
          <h3 class="mono-text" style="color: var(--text-primary); margin-bottom: 1rem;">METADATA</h3>
          
          <div style="margin-bottom: 1rem;">
            <div class="mono-text" style="font-size: 0.65rem; color: var(--text-tertiary); margin-bottom: 0.2rem;">ROLE</div>
            <div><%= project.role || 'Sole Developer' %></div>
          </div>
          
          <% if (project.metrics && project.metrics.users) { %>
            <div style="margin-bottom: 1rem;">
              <div class="mono-text" style="font-size: 0.65rem; color: var(--text-tertiary); margin-bottom: 0.2rem;">METRICS</div>
              <div class="flex gap-4">
                <div>
                  <div style="font-size: 1.2rem; color: var(--text-primary);"><%= project.metrics.users %></div>
                  <div class="mono-text" style="font-size: 0.6rem; color: var(--text-tertiary);">USERS</div>
                </div>
                <% if (project.metrics.gmv) { %>
                  <div>
                    <div style="font-size: 1.2rem; color: var(--text-primary);"><%= project.metrics.gmv %></div>
                    <div class="mono-text" style="font-size: 0.6rem; color: var(--text-tertiary);">GMV</div>
                  </div>
                <% } %>
              </div>
            </div>
          <% } %>

          <div style="margin-bottom: 1.5rem;">
            <div class="mono-text" style="font-size: 0.65rem; color: var(--text-tertiary); margin-bottom: 0.5rem;">STACK</div>
            <div class="flex gap-2" style="flex-wrap: wrap;">
              <% project.stack.forEach(tech => { %>
                <span class="badge"><%= tech %></span>
              <% }) %>
            </div>
          </div>

          <% if (project.links && (project.links.live || project.links.github)) { %>
            <div class="flex-col gap-2 border-t" style="padding-top: 1rem;">
              <% if (project.links.live) { %>
                <a href="<%= project.links.live %>" class="btn btn-primary" target="_blank" rel="noopener">Visit Live System ↗</a>
              <% } %>
              <% if (project.links.github) { %>
                <a href="<%= project.links.github %>" class="btn" target="_blank" rel="noopener">View Source ↗</a>
              <% } %>
            </div>
          <% } %>
        </div>
      </div>
    </aside>
  </div>
</main>

<style>
.markdown-body h2 { font-family: var(--font-display); font-size: 2rem; margin: 2rem 0 1rem; color: var(--text-primary); }
.markdown-body h3 { font-family: var(--font-display); font-size: 1.5rem; margin: 1.5rem 0 1rem; color: var(--text-primary); }
.markdown-body p { margin-bottom: 1.5rem; }
.markdown-body ul { margin-bottom: 1.5rem; padding-left: 1.5rem; }
.markdown-body li { margin-bottom: 0.5rem; }
.markdown-body img { max-width: 100%; border-radius: var(--radius-sm); border: 1px solid var(--border-subtle); margin: 1.5rem 0; }
.code-block { background: #0a0a0b; padding: 1rem; border-radius: var(--radius-sm); border: 1px solid var(--border-subtle); overflow-x: auto; margin-bottom: 1.5rem; font-family: var(--font-mono); font-size: 0.85rem; }
.post-callout { border-left: 3px solid var(--accent); padding-left: 1rem; margin: 1.5rem 0; color: var(--text-primary); font-style: italic; }
@media (max-width: 800px) {
  .grid { grid-template-columns: 1fr !important; }
}
</style>

<%- include('../partials/footer') %>